{
  "name": "lab",
  "short_name": "lab",
  "description": "Phone-first control panel for Claude Code agents",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#faf9f5",
  "background_color": "#faf9f5",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New run",
      "short_name": "New run",
      "description": "Start a run from the composer",
      "url": "/new",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Repos",
      "short_name": "Repos",
      "description": "Your repositories",
      "url": "/repos",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
