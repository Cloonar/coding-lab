# agent-tools CLI version catalog — the single source of truth for the
# per-provider agent-tools OCI images (issue #203, ADR-0051). Sourced verbatim
# by build.sh, smoke-test.sh, and the publish job in
# .forgejo/workflows/agent-tools.yml, so keep it plain KEY=VALUE: no `export`,
# no quoting, no shell expansion — it must source identically in sh, bash, and
# YAML-embedded shell.
#
# These versions ARE the repo's compat pins: CLAUDE_CODE_VERSION mirrors
# internal/compat/compat.md and CODEX_VERSION mirrors
# internal/compat/codex/compat.md. The compat record stays the authority.
# BEFORE bumping a version here, re-verify the compat record against the new
# CLI version FIRST (the compat doc is the checklist), THEN move the version +
# sha256 together. A bump that skips the re-verification ships an unverified CLI
# under a pin that claims verification — see docs/ops.md § "Agent-tools images"
# and ADR-0051 for the full bump procedure.

# Claude Code — sha256 of the linux-x64-musl `claude` binary, taken from
# Anthropic's per-version manifest.json at
# downloads.claude.ai/claude-code-releases/<ver>/manifest.json.
CLAUDE_CODE_VERSION=2.1.198
CLAUDE_CODE_SHA256_X64_MUSL=42892159a03bee492926b616b1270313544f7a52b68d32cb680e91984a4c6659

# codex — sha256 of the GitHub release asset
# codex-x86_64-unknown-linux-musl.tar.gz (the release's per-asset digest).
CODEX_VERSION=0.133.0
CODEX_SHA256_X64_MUSL_TGZ=d06019ab9c35d281b78dc2ebb2ae55c2bb97ea11bf7f452bafe390eddb0034ef

# gemini seam: no image ships until the gemini adapter (#126) lands. When it
# does, add GEMINI_VERSION + its artifact sha256 here and a Containerfile.gemini
# following the claude/codex pattern — no change to the mechanism or CI legs.
