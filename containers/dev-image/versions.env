# dev-image version catalog — the pins behind the full dev image (ADR-0069).
# Sourced verbatim by build.sh and smoke-test.sh, so keep it plain KEY=VALUE:
# no `export`, no quoting, no shell expansion (the agent-tools versions.env
# rule). A value holding several items separates them with commas.
#
# Everything NOT pinned here floats on purpose: Debian packages come from the
# release's own archive and move with its security updates, and the monthly
# rebuild (.github/workflows/dev-image.yml) is what delivers them.

# Debian release the image is built on. It names the buildpack-deps base tag,
# the golang/node builder tags, and the PHP archive's suite, so a release
# jump is one reviewed edit here.
DEBIAN_RELEASE=trixie

# Go toolchain (the golang:<ver>-<release> image). Go's own toolchain
# switching stays on, so a repo whose go.mod asks for a newer Go fetches it.
GO_VERSION=1.26

# golangci-lint release — matches the version .github/workflows/ci.yml pins.
GOLANGCI_LINT_VERSION=2.12.2

# Node.js major (the node:<major>-<release>-slim image) — the current LTS.
NODE_MAJOR=24

# PHP versions installed side by side as php<ver>, comma-separated, and the
# one the bare `php` command means.
PHP_VERSIONS=8.2,8.3,8.4
PHP_DEFAULT=8.2
