#!/bin/sh
# start-postgres — start a throwaway PostgreSQL for this session.
#
# Listens on 127.0.0.1:${PGPORT:-5432}; superuser `postgres`, any password
# accepted. Data lives under ${DEVDB_DIR:-/tmp/devdb}/postgres and is gone
# with the container. Safe to run again: a running server is left alone.
set -eu

dir="${DEVDB_DIR:-/tmp/devdb}/postgres"
port="${PGPORT:-5432}"

if [ ! -s "${dir}/PG_VERSION" ]; then
  mkdir -p "${dir}"
  initdb -D "${dir}" -U postgres --auth=trust -E UTF8 --locale=C.UTF-8 >/dev/null
fi

if ! pg_ctl -D "${dir}" status >/dev/null 2>&1; then
  # The socket goes into the data dir: the packaged default, /run/postgresql,
  # is not writable by the session user.
  pg_ctl -D "${dir}" -w -l "${dir}/server.log" \
    -o "-p ${port} -c listen_addresses=127.0.0.1 -c unix_socket_directories=${dir}" \
    start >/dev/null
fi

echo "postgres ready: postgresql://postgres@127.0.0.1:${port}/postgres"
echo "  log: ${dir}/server.log   stop: pg_ctl -D ${dir} stop"
